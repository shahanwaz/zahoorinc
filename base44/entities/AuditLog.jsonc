{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "admin_id": {
      "type": "string",
      "description": "ID of admin who performed action"
    },
    "admin_name": {
      "type": "string",
      "description": "Name of admin"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "create",
        "update",
        "delete",
        "approve",
        "reject",
        "suspend",
        "restore"
      ],
      "description": "Type of action performed"
    },
    "entity_type": {
      "type": "string",
      "description": "Type of entity affected (User, Ejara, Payment, etc.)"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of affected entity"
    },
    "details": {
      "type": "object",
      "description": "Additional details about the action"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of admin"
    }
  },
  "required": [
    "admin_id",
    "action_type",
    "entity_type"
  ]
}