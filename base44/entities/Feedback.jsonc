{
  "name": "Feedback",
  "type": "object",
  "properties": {
    "feedback_text": {
      "type": "string",
      "description": "The content of the user's feedback or report"
    },
    "category": {
      "type": "string",
      "enum": [
        "Post",
        "Event",
        "User",
        "Message",
        "Other"
      ],
      "description": "The category of the reported content"
    },
    "screenshot_url": {
      "type": "string",
      "description": "URL of the uploaded screenshot"
    },
    "user_id": {
      "type": "string",
      "description": "The ID of the user providing feedback"
    },
    "user_email": {
      "type": "string",
      "description": "The email of the user providing feedback"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "viewed",
        "in_progress",
        "resolved"
      ],
      "default": "new",
      "description": "Status of the feedback"
    }
  },
  "required": [
    "feedback_text",
    "user_id",
    "user_email",
    "category"
  ]
}