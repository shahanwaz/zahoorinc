{
  "name": "Answer",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "description": "ID of the question being answered"
    },
    "content": {
      "type": "string",
      "description": "Answer content"
    },
    "language": {
      "type": "string",
      "default": "en",
      "description": "Language code of the answer"
    },
    "author_id": {
      "type": "string",
      "description": "ID of the user who posted the answer"
    },
    "author_name": {
      "type": "string",
      "description": "Cached name of the author"
    },
    "author_role": {
      "type": "string",
      "enum": [
        "maulana",
        "tutor",
        "zakir",
        "user"
      ],
      "description": "Role of the author"
    },
    "author_avatar": {
      "type": "string",
      "description": "Cached avatar URL of the author"
    },
    "media_urls": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Attached images or videos"
    },
    "likes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user IDs who liked the answer"
    },
    "dislikes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user IDs who disliked the answer"
    },
    "reactions": {
      "type": "object",
      "properties": {
        "like": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "love": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "insight": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pray": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Different reaction types with user IDs"
    },
    "comment_count": {
      "type": "number",
      "default": 0,
      "description": "Number of comments on this answer"
    },
    "share_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this answer was shared"
    },
    "is_best_answer": {
      "type": "boolean",
      "default": false,
      "description": "Whether this is marked as the best answer"
    },
    "score": {
      "type": "number",
      "default": 0,
      "description": "Calculated score for sorting (likes - dislikes + reactions)"
    }
  },
  "required": [
    "question_id",
    "content",
    "author_id"
  ]
}