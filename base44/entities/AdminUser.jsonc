{
  "name": "AdminUser",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Reference to the main User entity"
    },
    "role": {
      "type": "string",
      "enum": [
        "super_admin",
        "moderator",
        "finance_admin",
        "support_admin",
        "content_admin"
      ],
      "description": "Admin role with specific permissions"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Specific permissions for this admin"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether admin account is active"
    },
    "two_factor_enabled": {
      "type": "boolean",
      "default": false,
      "description": "2FA status"
    },
    "last_login": {
      "type": "string",
      "format": "date-time",
      "description": "Last login timestamp"
    }
  },
  "required": [
    "user_id",
    "role"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "super_admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        },
        {
          "user_condition": {
            "role": "finance_admin"
          }
        },
        {
          "user_condition": {
            "role": "support_admin"
          }
        },
        {
          "user_condition": {
            "role": "content_admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "super_admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "super_admin"
      }
    }
  }
}