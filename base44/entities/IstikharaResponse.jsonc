{
  "name": "IstikharaResponse",
  "type": "object",
  "properties": {
    "request_id": {
      "type": "string",
      "description": "ID of the Istikhara request this response is for"
    },
    "scholar_id": {
      "type": "string",
      "description": "ID of the scholar providing the response"
    },
    "scholar_name": {
      "type": "string",
      "description": "Cached name of the scholar"
    },
    "scholar_role": {
      "type": "string",
      "enum": [
        "maulana",
        "zakir",
        "zakera"
      ],
      "description": "Role of the scholar"
    },
    "response_text": {
      "type": "string",
      "description": "The Istikhara guidance and result"
    },
    "attachment_url": {
      "type": "string",
      "description": "Optional attachment URL (image, PDF, audio)"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private"
      ],
      "default": "private",
      "description": "Always private - only requester can see"
    },
    "requester_id": {
      "type": "string",
      "description": "Cached requester ID for quick access control"
    }
  },
  "required": [
    "request_id",
    "scholar_id",
    "scholar_name",
    "response_text",
    "requester_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.scholar_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.requester_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    },
    "update": {
      "$or": []
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "moderator"
          }
        }
      ]
    }
  }
}