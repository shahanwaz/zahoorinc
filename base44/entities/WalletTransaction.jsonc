{
  "name": "WalletTransaction",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "User ID this transaction belongs to"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "add_money",
        "istikhara_request",
        "istikhara_earning",
        "ejara_request",
        "ejara_earning",
        "withdrawal",
        "refund"
      ],
      "description": "Type of transaction"
    },
    "amount": {
      "type": "number",
      "description": "Transaction amount (positive for credits, negative for debits)"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed"
      ],
      "default": "completed",
      "description": "Transaction status"
    },
    "reference_id": {
      "type": "string",
      "description": "Reference to related entity (Istikhara ID, Payment ID, etc.)"
    },
    "reference_type": {
      "type": "string",
      "enum": [
        "istikhara",
        "ejara",
        "payment",
        "withdrawal"
      ],
      "description": "Type of reference"
    },
    "description": {
      "type": "string",
      "description": "Human-readable transaction description"
    },
    "payment_method": {
      "type": "string",
      "description": "Payment method used (if applicable)"
    },
    "balance_after": {
      "type": "number",
      "description": "User's wallet balance after this transaction"
    }
  },
  "required": [
    "user_id",
    "transaction_type",
    "amount",
    "status"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "finance_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "finance_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "finance_admin"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}